<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | Global Secure Systems</title>
    <link rel="stylesheet" href="/styles.css">    
    <style>
        body {
            background-color: #f4f7f6;
            padding: 20px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            background: white;
            padding: 1.5rem;
            border-radius: 12px;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .user-badge {
            display: inline-block;
            background: #e8f0fe;
            color: #1a73e8;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 0.9rem;
        }

        .user-badge.admin {
            background: #fce4ec;
            color: #c2185b;
        }

        .nav-buttons {
            display: flex;
            gap: 10px;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <div class="user-info">
            <h1>Global Secure Systems</h1>
            <span class="user-badge <%= isAdmin ? 'admin' : '' %>">
                <%= isAdmin ? 'ADMIN' : 'USER: ' + user %>
            </span>
        </div>
        <div class="nav-buttons">
            <a href="/" class="btn btn-secondary">Home</a>
            <a href="/logout" class="btn btn-danger">Logout</a>
        </div>
    </div>

    <% if (isAdmin) { %>
        <div class="section">
            <h2>Admin Dashboard</h2>
            <div class="admin-flag">
                <strong>FLAG:</strong>
                <div class="flag-content"><%= flag %></div>
            </div>
        </div>

    <% } else { %>

        <div class="section">
            <h2>Update Status</h2>
            <form method="POST" action="/status">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                    <label for="content">Status</label>
                    <textarea id="content" name="content" placeholder="What's on your mind?" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Update Status</button>
            </form>
        </div>


        <div class="section">
            <h2>All Statuses</h2>
            <% 
                const statusUsernames = Object.keys(statuses);
                if (statusUsernames.length === 0) { 
            %>
                <p class="text-muted">No statuses yet.</p>
            <% } else { %>
                <% statusUsernames.forEach(username => { %>
                    <div class="post-card">
                        <div class="post-meta">
                            <strong><%= username %></strong>
                            <span><%= new Date(statuses[username].createdAt).toLocaleString() %></span>
                        </div>
                        <div class="post-content"><%= statuses[username].content %></div>
                        <div class="post-actions">
                            <a href="/view-status/<%= username %>" class="btn btn-primary btn-small">View Status</a>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>


        <div class="section">
            <h2>Reset Password</h2>
            <div class="password-reset-form">
                <form method="POST" action="/request-password-reset">
                    <div class="form-group">
                        <label for="reset-username">Username</label>
                        <input type="text" id="reset-username" name="username" placeholder="Your username" required>
                    </div>
                    <div class="form-group">
                        <label for="reset-email">Email</label>
                        <input type="email" id="reset-email" name="email" placeholder="Your registered email" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Request Reset Link</button>
                </form>
            </div>
        </div>

    <% } %>

</div>

</body>
</html>