<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Recovery | Secure Portal</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f7f6;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .recovery-card {
            background: white;
            padding: 2.5rem;
            border-radius: 12px;
            width: 100%;
            max-width: 400px;
            text-align: center;
        }

        .icon {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        h2 {
            color: #2c3e50;
            margin-bottom: 1rem;
        }

        p {
            color: #5f6368;
            font-size: 0.9rem;
            margin-bottom: 2rem;
            line-height: 1.5;
        }

        input[type="email"] {
            width: 100%;
            padding: 12px;
            margin-bottom: 1.5rem;
            border: 1px solid #dadce0;
            border-radius: 6px;
            box-sizing: border-box;
            font-size: 1rem;
            outline: none;
            transition: border-color 0.2s;
        }

        input[type="email"]:focus {
            border-color: #1a73e8;
        }

        button {
            width: 100%;
            background-color: #1a73e8;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        button:hover {
            background-color: #1765cc;
        }

        .back-link {
            display: block;
            margin-top: 1.5rem;
            font-size: 0.85rem;
            color: #1a73e8;
            text-decoration: none;
        }
    </style>
</head>
<body>

    <div class="recovery-card">
        <h2>Account Recovery</h2>
        <p>Enter your registered email address below. We will generate a secure reset token for your account.</p>

        <form method="POST" action="/forgot-password">
            <input type="email" name="email" placeholder="email@example.com" required />
            <button type="submit">Generate Reset Link</button>
        </form>

        <a href="/dashboard" class="back-link">Return to Dashboard</a>
    </div>

</body>
</html>